# ==========================================
# CureForever — Enterprise .gitignore
# Confidential, Environment & Local Artifacts
# ==========================================

# 1. Environment & API Secrets
.env
.env*
!.env.example
*.env
credentials.json
service-account*.json
*.pem
*.key
*.cert
*.crt
*.pfx

# 2. Local AI & Agent Workspace Directories
.agents/
.gemini/
.claude/
.system_generated/
headroom.log
*.log
*.db

# 3. Dependencies & Package Managers
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
yarn-debug.log*
yarn-error.log*
npm-debug.log*
.pnpm-debug.log*

# 4. Next.js & Build Outputs
/.next/
/out/
/build/
/dist/
/.turbo/
/coverage/

# 5. Vercel & Deployment Artifacts
.vercel

# 6. TypeScript & Build Info
*.tsbuildinfo
next-env.d.ts

# 7. IDEs & Code Editors
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vs/

# 8. OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# 9. Temporary & Scratch Files
*.tmp
*.temp
/scratch/
*.bak
